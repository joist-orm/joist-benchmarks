{
  "name": "joist-benchmarks",
  "packageManager": "yarn@4.7.0",
  "private": true,
  "scripts": {
    "generate-seed-data": "yarn workspace seed-data generate",
    "db-up": "docker compose up -d",
    "db-down": "docker compose down",
    "db-psql": "docker exec -it joist-benchmarks-db-1 psql -U postgres -d benchmark",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml}\"",
    "benchmark": "yarn workspace benchmark benchmark",
    "pipeline": "yarn workspace benchmark pipeline",
    "codegen": "yarn workspaces foreach --all run codegen"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*"
  ]
}
