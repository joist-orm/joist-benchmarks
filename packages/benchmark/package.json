{
  "name": "benchmark",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "@source": "./src/index.ts",
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      },
      "require": {
        "@source": "./src/index.ts",
        "default": "./dist/index.js",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "benchmark": "SWCRC=true node --conditions=@source --import @swc-node/register/esm-register --enable-source-maps src/benchmark.ts",
    "pipeline": "node --expose-gc --import tsx --conditions=@source src/pipeline.ts"
  },
  "dependencies": {
    "@cloud-copilot/cli": "^0.2.27",
    "benchmark-drizzle": "workspace:^",
    "benchmark-joist-v1": "workspace:^",
    "benchmark-joist-v2": "workspace:^",
    "benchmark-mikroorm": "workspace:^",
    "benchmark-node-pg": "workspace:^",
    "benchmark-prisma": "workspace:^",
    "benchmark-typeorm": "workspace:^",
    "cli-table3": "^0.6.5",
    "colors": "^1.4.0",
    "mitata": "^1.0.34",
    "postgres": "^3.4.7",
    "seed-data": "workspace:^"
  },
  "devDependencies": {
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.8",
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3"
  }
}
